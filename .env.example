NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/backend_standalone
REDIS_URL=redis://127.0.0.1:6384/0
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
TRUST_PROXY=0

# File routes are disabled until this server-side key and storage credentials are set.
# Generate a random key of at least 32 characters; never put it in a public frontend.
FILES_API_KEY=
FILES_KEY_PREFIX=standalone/
WASABI_BUCKET=
WASABI_REGION=us-east-1
WASABI_URL=wasabisys.com
WASABI_ACCESS_KEY_ID=
WASABI_SECRET_ACCESS_KEY=
# Optional full S3-compatible endpoint; AWS example: https://s3.us-east-1.amazonaws.com
WASABI_ENDPOINT=
# Optional public bucket for shared helpers; the HTTP file routes use the private bucket.
WASABI_PUBLIC_BUCKET=
WASABI_PUBLIC_REGION=us-east-1
WASABI_PUBLIC_ACCESS_KEY_ID=
WASABI_PUBLIC_SECRET_ACCESS_KEY=
