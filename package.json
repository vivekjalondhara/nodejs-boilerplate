{
  "name": "backend-standalone",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "openapi:types": "openapi-typescript openapi/openapi.yaml -o src/generated/openapi.ts",
    "redis:up": "docker compose up -d --wait redis",
    "redis:down": "docker compose stop redis",
    "redis:check": "tsx tests/redis.check.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1145.0",
    "@aws-sdk/lib-storage": "^3.1145.0",
    "@aws-sdk/s3-request-presigner": "^3.1145.0",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^7.0.0",
    "joi": "^17.9.2",
    "multer": "^2.4.0",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "redis": "^5.12.1",
    "reflect-metadata": "^0.2.1",
    "sequelize": "^6.32.1",
    "sequelize-typescript": "^2.1.5",
    "sharp": "^0.35.5",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.10.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.18",
    "@types/jest": "^29.4.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.17.57",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/validator": "^13.11.9",
    "@typescript-eslint/eslint-plugin": "^6.9.1",
    "@typescript-eslint/parser": "^6.9.1",
    "eslint": "^8.48.0",
    "jest": "^29.4.1",
    "openapi-typescript": "^7.13.0",
    "sequelize-cli": "^6.6.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "tsx": "^4.19.0",
    "typescript": "~5.2.2"
  }
}
